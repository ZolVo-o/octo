#!/usr/bin/env bash
set -euo pipefail

OCTO_SRC="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -x "${OCTO_SRC}/target/octo-backend" ]]; then
    DEFAULT_BACKEND="${OCTO_SRC}/target/octo-backend"
elif [[ -x /usr/lib/octo/octo-backend ]]; then
    DEFAULT_BACKEND=/usr/lib/octo/octo-backend
else
    DEFAULT_BACKEND="${OCTO_SRC}/target/octo-backend"
fi
BACKEND="${OCTO_BACKEND_BIN:-${DEFAULT_BACKEND}}"

if [[ "${1:-}" == "tui" || "${1:-}" == "ui" ]]; then
    shift
    if [[ -x "${OCTO_SRC}/target/debug/octo-tui" ]]; then
        OCTO_BACKEND="$BACKEND" exec "${OCTO_SRC}/target/debug/octo-tui" "$@"
    elif [[ -x /usr/lib/octo/octo-tui ]]; then
        OCTO_BACKEND="$BACKEND" exec /usr/lib/octo/octo-tui "$@"
    elif command -v cargo >/dev/null 2>&1 && [[ -f "${OCTO_SRC}/Cargo.toml" ]]; then
        OCTO_BACKEND="$BACKEND" exec cargo run --quiet --manifest-path "${OCTO_SRC}/Cargo.toml" --bin octo-tui -- "$@"
    else
        echo "🐙 Rust TUI не собран. Установите Rust и выполните: cargo build" >&2
        exit 1
    fi
fi

if [[ ! -x "$BACKEND" ]]; then
    echo "🐙 C++ backend не собран. Запустите ./install.sh или выполните:" >&2
    echo "   g++ -std=c++17 -O2 -Wall -Wextra backend/octo_backend.cpp -o target/octo-backend" >&2
    exit 1
fi

exec "$BACKEND" "$@"
